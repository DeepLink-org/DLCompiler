+def _module_files(path, prefix):
+    """Find package files without executing vendor package initializers."""
+    import pkgutil
+
+    for lib in pkgutil.iter_modules([path], prefix=prefix):
+        spec = lib.module_finder.find_spec(lib.name)
+        yield spec.origin
+        if lib.ispkg:
+            for child_path in spec.submodule_search_locations:
+                yield from _module_files(child_path, lib.name + ".")
+
